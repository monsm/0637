diff --git a/duck-control/Cargo.toml b/duck-control/Cargo.toml
index b53d572..072887d 100644
--- a/duck-control/Cargo.toml
+++ b/duck-control/Cargo.toml
@@ -29,20 +29,33 @@ tracing.workspace = true
 libloading = "0.8"
 # Identify unchanged networks when a different slot is hot-swapped.
 sha2 = "0.11.0"
-ort = { version = "=2.0.0-rc.11", default-features = false, features = ["load-dynamic"] }
+ort = { version = "=2.0.0-rc.11", default-features = false }
 
 # 1.7.0 is a floor, not a preference: it adds fast sync read (protocol 2.0 instruction
 # 0x8A), which `bus` enables and the tick budget depends on. 1.6.0 was the previous floor
 # for the same kind of reason — it de-stuffs protocol 2.0 status packets whose payload
 # contains `FF FF FD`, and before it such a read came back oversized and every fixed-size
 # sync read in `bus` decoded garbage. A present current of -1 is enough to trigger that.
-rustypot = "1.8.0"
+rustypot = { version = "1.8.0", optional = true }
 # `default-features = false` drops serialport's `libudev` feature, which exists only for
 # enumerating ports (`available_ports`). We open one by path from the params file and never
 # enumerate — and libudev-sys needs a pkg-config sysroot that the board's cross-build does
 # not have, so leaving it on breaks the aarch64 build outright. rustypot disables it for the
 # same reason; this crate has to as well, or cargo's feature unification turns it back on.
-serialport = { version = "4.8", default-features = false }
+serialport = { version = "4.8", default-features = false, optional = true }
+
+[features]
+# Mobile builds use a simulator/custom RobotIo and have no Dynamixel bus. The
+# control core (obs/policy/safety/fall) is pure and compiles without these.
+default = ["hardware", "onnx-dynamic"]
+hardware = ["dep:rustypot", "dep:serialport"]
+# Desktop/board: dlopen the ONNX Runtime shared library.
+onnx-dynamic = ["ort/load-dynamic"]
+# iOS/static: link libonnxruntime.a from an XCFramework
+# (ORT_IOS_XCFWK_LOCATION), with no dylib probe. `std` is what unlocks the
+# Session API; ort-sys picks up the xcframework whenever that env var is set
+# for an iOS target.
+onnx-static = ["ort/std"]
 
 [dev-dependencies]
 serde_json.workspace = true
